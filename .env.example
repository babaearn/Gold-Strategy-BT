# ============================================================
# XAUT Live Bot — Environment Variables Template
# ============================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#   nano .env            ← fill in your real values
#
# On Railway: paste each variable into the service's
#   Settings → Variables tab (never commit a real .env file).
# ============================================================


# ── Bybit API Credentials (REQUIRED) ────────────────────────
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# true  = Bybit Testnet (paper trading — safe to experiment)
# false = Bybit Mainnet (real prices + real account equity, required for paper-mode forward testing)
BYBIT_TESTNET=false

# ── Paper / Forward-Test Mode ────────────────────────────────
# true  = virtual positions only — bot tracks SL/TP candle-by-candle, no real orders placed
# false = live trading (real orders on Bybit)
PAPER_MODE=true


# ── Instrument ───────────────────────────────────────────────
SYMBOL=XAUTUSDT


# ── Strategy Selection ───────────────────────────────────────
# Which strategy to run.  Switch at runtime via Telegram /set <n>.
#   1 = Volatility Expansion Channel (4-Phase) — default & current
#   2 = (add your next strategy and set ACTIVE_STRATEGY=2)
ACTIVE_STRATEGY=1


# ── Strategy Parameters (optional — defaults match backtest) ─
# EMA periods
EMA_FAST=12
EMA_MEDIUM=18
EMA_SLOW=26
EMA_CONFIRM=1
ATR_PERIOD=14
ATR_REGIME_LOOKBACK=20

# SL / TP ATR multipliers
LONG_ATR_SL_MULT=2.5
LONG_ATR_TP_MULT=9.0
SHORT_ATR_SL_MULT=2.5
SHORT_ATR_TP_MULT=6.5

# Pullback & window timing
LONG_PULLBACK_MAX=1
SHORT_PULLBACK_MAX=1
LONG_WINDOW_PERIODS=5
SHORT_WINDOW_PERIODS=7
WINDOW_PRICE_OFFSET=0.001

# ── Trend Filter (optional phase-1 quality gate) ─────────────
# Requires ema_slow to be trending in the signal direction before arming.
# TREND_FILTER_BARS = how many bars back to compare ema_slow.
#
# ★ RECOMMENDED (Optimization Idea 1 — Best Return):
#   TREND_FILTER=true, TREND_FILTER_BARS=15
#   LONG_ATR_TP_MULT=12.0, SHORT_ATR_TP_MULT=9.0, RISK_PERCENT=0.01
#   → 5-year backtest: +52% return  |  8.4% MaxDD  |  4.9 trades/month  |  Win RR 3.94×
#
# ★ CONSERVATIVE (Optimization Idea 2 — Lowest Drawdown):
#   TREND_FILTER=true, TREND_FILTER_BARS=10
#   LONG_ATR_TP_MULT=12.0, SHORT_ATR_TP_MULT=9.0, RISK_PERCENT=0.0075
#   → 5-year backtest: +32.7% return  |  7.1% MaxDD  |  5.0 trades/month  |  Win RR 3.90×
#
# ★ HIGH RR (Optimization Idea 3 — Best Win RR):
#   TREND_FILTER=true, TREND_FILTER_BARS=5
#   LONG_ATR_SL_MULT=2.0, SHORT_ATR_SL_MULT=2.0
#   LONG_ATR_TP_MULT=12.0, SHORT_ATR_TP_MULT=9.0, RISK_PERCENT=0.0075
#   → 5-year backtest: +45.5% return  |  9.96% MaxDD  |  5.1 trades/month  |  Win RR 4.83×
TREND_FILTER=true
TREND_FILTER_BARS=15


# ── Strategy 2 — Opening Range Breakout (London Session) ─────────────────────
# Active when ACTIVE_STRATEGY=2
#
# Builds the opening range from the first ORB_RANGE_BARS × 5-min candles of the
# session (13:00 UTC).  Default: 12 bars = 60 minutes (13:00–14:00 UTC).
# Then trades the first breakout in the ema_slow trend direction.
#
# ★ BACKTEST VALIDATED (5yr XAUUSD 5-min, 1 trade/day max):
#   ORB_RANGE_BARS=12  ORB_SL_RANGE_FRAC=0.7  ORB_TP_RANGE_MULT=2.0
#   RISK_PERCENT=0.007
#   → Win Rate: 42.8%  |  18.3 trades/month  |  MaxDD ~14.6%  |  5yr return ~38.7%
#
# When switching to Strategy 2 via /set 2 or restart:
#   ACTIVE_STRATEGY=2
#   ORB_RANGE_BARS=12
#   ORB_SL_RANGE_FRAC=0.7
#   ORB_TP_RANGE_MULT=2.0
#   RISK_PERCENT=0.007
ORB_RANGE_BARS=12
ORB_SL_RANGE_FRAC=0.7
ORB_TP_RANGE_MULT=2.0


# ── Risk / Position Sizing ────────────────────────────────────
# Fraction of equity to risk per trade
# 0.01 = 1%  |  0.005 = 0.5%  |  0.02 = 2%
RISK_PERCENT=0.01


# ── Session Filter (UTC hours) ────────────────────────────────
USE_SESSION_FILTER=true
SESSION_START_HOUR=13    # London open
SESSION_END_HOUR=18      # NY afternoon — positions closed after this


# ── Volatility Regime Filter ──────────────────────────────────
# true = only enter trades when ATR > EMA-of-ATR (expanding volatility)
USE_VOLATILITY_REGIME=true


# ── Trade Direction ───────────────────────────────────────────
ENABLE_LONG=true
ENABLE_SHORT=true


# ── Telegram Bot (optional but recommended) ───────────────────
# 1. Create a bot via @BotFather → copy the token
# 2. Get your chat ID: message @userinfobot, or start your bot
#    and visit: https://api.telegram.org/bot<TOKEN>/getUpdates
# Leave blank → bot runs without Telegram.
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here


# ── Logging ───────────────────────────────────────────────────
# DEBUG  = very verbose (development)
# INFO   = normal (production)
# WARNING = quiet
LOG_LEVEL=INFO
