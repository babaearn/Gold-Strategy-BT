# ============================================================
# XAUT Live Bot — Environment Variables Template
# ============================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#   nano .env            ← fill in your real values
#
# On Railway: paste each variable into the service's
#   Settings → Variables tab (never commit a real .env file).
# ============================================================


# ── Bybit API Credentials (REQUIRED) ────────────────────────
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# true  = Bybit Testnet (paper trading — safe to experiment)
# false = Bybit Mainnet (real prices + real account equity, required for paper-mode forward testing)
BYBIT_TESTNET=false

# ── Paper / Forward-Test Mode ────────────────────────────────
# true  = virtual positions only — bot tracks SL/TP candle-by-candle, no real orders placed
# false = live trading (real orders on Bybit)
PAPER_MODE=true


# ── Instrument ───────────────────────────────────────────────
SYMBOL=XAUTUSDT


# ── Strategy Parameters (optional — defaults match backtest) ─
# EMA periods
EMA_FAST=12
EMA_MEDIUM=18
EMA_SLOW=26
EMA_CONFIRM=1
ATR_PERIOD=14
ATR_REGIME_LOOKBACK=20

# SL / TP ATR multipliers
LONG_ATR_SL_MULT=2.5
LONG_ATR_TP_MULT=9.0
SHORT_ATR_SL_MULT=2.5
SHORT_ATR_TP_MULT=6.5

# Pullback & window timing
LONG_PULLBACK_MAX=2
SHORT_PULLBACK_MAX=2
LONG_WINDOW_PERIODS=5
SHORT_WINDOW_PERIODS=7
WINDOW_PRICE_OFFSET=0.001


# ── Risk / Position Sizing ────────────────────────────────────
# Fraction of equity to risk per trade
# 0.01 = 1%  |  0.005 = 0.5%  |  0.02 = 2%
RISK_PERCENT=0.01


# ── Session Filter (UTC hours) ────────────────────────────────
USE_SESSION_FILTER=true
SESSION_START_HOUR=13    # London open
SESSION_END_HOUR=18      # NY afternoon — positions closed after this


# ── Volatility Regime Filter ──────────────────────────────────
# true = only enter trades when ATR > EMA-of-ATR (expanding volatility)
USE_VOLATILITY_REGIME=true


# ── Trade Direction ───────────────────────────────────────────
ENABLE_LONG=true
ENABLE_SHORT=true


# ── Telegram Bot (optional but recommended) ───────────────────
# 1. Create a bot via @BotFather → copy the token
# 2. Get your chat ID: message @userinfobot, or start your bot
#    and visit: https://api.telegram.org/bot<TOKEN>/getUpdates
# Leave blank → bot runs without Telegram.
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here


# ── Logging ───────────────────────────────────────────────────
# DEBUG  = very verbose (development)
# INFO   = normal (production)
# WARNING = quiet
LOG_LEVEL=INFO
